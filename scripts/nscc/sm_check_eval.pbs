#!/bin/bash
# 第一个 GPU 作业（Breezewrf/supermimic_mjlab）：查驱动和 CUDA → 评测作者发布的模型 → 导出两段 mp4。
# 用法（在上游代码目录提交，PBS_O_WORKDIR 就是它）：
#   cd ~/projects/supermimic_mjlab && mkdir -p logs && qsub <本仓库路径>/scripts/nscc/sm_check_eval.pbs
# 实际大约只用十几分钟；walltime 写 2.5 h 是为了进 g1 而不是常排长队的 gdev，没用完的 SU 会退回。
#PBS -N sm_check
# 下一行改成自己的记账项目号（NSCC 上用 myprojects 查）
#PBS -P <你的项目号>
#PBS -q normal
#PBS -l select=1:ngpus=1
#PBS -l walltime=02:30:00
#PBS -j oe
#PBS -o logs/

set -uo pipefail
cd "${PBS_O_WORKDIR:?请在仓库根目录提交}"
source .venv/bin/activate
export PYTHONUNBUFFERED=1
export MUJOCO_GL=egl
OUT=outputs/check && mkdir -p "$OUT"

echo "===== 1. 驱动与 CUDA ====="
nvidia-smi
python - <<'PY'
from importlib.metadata import version
import torch
for p in ("torch", "mjlab", "mujoco", "mujoco-warp", "warp-lang"):
    print(p, version(p))
print("torch:", torch.__version__, "| torch CUDA build:", torch.version.cuda, "| available:", torch.cuda.is_available())
if torch.cuda.is_available():
    print("GPU:", torch.cuda.get_device_name(0))
try:
    import warp as wp
    wp.init()
    print("warp CUDA devices:", wp.get_cuda_device_count())
except Exception as e:
    print("warp init FAILED:", repr(e))
PY

echo "===== 2. 评测发布模型（40 段 LAFAN，作者结果 40/40、0.8528） ====="
python scripts/evaluate_supermimic.py \
  --device cuda:0 --checkpoint checkpoints/best/policy_best.pt \
  --output "$OUT/evaluation_best.json" \
  --motion-dir src/assets/motions/g1/lafan1_npz

echo "===== 3. 导出视频 ====="
for clip in walk1_subject1 dance1_subject1; do
  python scripts/evaluate_supermimic.py \
    --device cuda:0 --checkpoint checkpoints/best/policy_best.pt \
    --clips "$clip" --video "$OUT/$clip.mp4" \
    --output "$OUT/${clip}_eval.json" \
    --motion-dir src/assets/motions/g1/lafan1_npz
done

echo "JOB_FINISHED: $OUT"
